# Copiez ce fichier en .env et remplissez les valeurs.
# Générez les clés avec : python -c "import secrets; print(secrets.token_hex(32))"

# Persistance (vide = mode mémoire ; sinon chaîne Neon/Postgres)
DATABASE_URL=

# Clés cryptographiques (64 caractères hexadécimaux chacune, OBLIGATOIRES)
VAULT_MASTER_KEY=
AUDIT_HMAC_KEY=

# Token d'administration (création des clés clients via /admin/keys).
# Distinct des clés cryptographiques. Si vide, repli sur AUDIT_HMAC_KEY.
ADMIN_TOKEN=

# Rate-limiting : requêtes/minute par client (fenêtre glissante). 0 = désactivé.
RATE_LIMIT_PER_MINUTE=120

# Token du dashboard (stats + WebSocket temps réel).
# Vide = accès libre (dev/démo) ; défini = obligatoire.
DASHBOARD_TOKEN=

# Format des logs : json (production) ou text (dev lisible)
LOG_FORMAT=json

# Mode strict (production) : refuse de démarrer si persistance absente,
# clés par défaut, ou tokens admin/dashboard non définis. Fail-closed.
STRICT_MODE=false

# Durées de conservation.
# Jetons du vault (restauration des vraies valeurs) : supprimés au-delà.
VAULT_TTL_HOURS=24
# Journal d'audit, en jours (0 = illimité). Au-delà, les entrées sont
# CONSERVÉES — la chaîne doit rester vérifiable (AI Act art. 26(6)) —
# mais leur clé de déchiffrement est détruite : la preuve demeure, la
# donnée personnelle devient illisible.
AUDIT_RETENTION_DAYS=0
# Période entre deux passes de purge, en minutes (0 = désactivé).
PURGE_INTERVAL_MINUTES=60

# Juge local L4 (optionnel ; sur Docker, host.docker.internal pointe vers l'hôte)
OLLAMA_BASE_URL=http://host.docker.internal:11434
# Streaming : true = fragments du fournisseur relayés au fil de l'eau
# (latence minimale). false = réponse complète puis découpage simulé,
# ce qui rétablit la récupération floue des jetons corrompus.
STREAM_NATIVE=true
