# Copiez ce fichier en .env et remplissez les valeurs.
# Générez les clés avec : python -c "import secrets; print(secrets.token_hex(32))"

# Persistance (vide = mode mémoire ; sinon chaîne Neon/Postgres)
DATABASE_URL=

# Clés cryptographiques (64 caractères hexadécimaux chacune, OBLIGATOIRES)
VAULT_MASTER_KEY=
AUDIT_HMAC_KEY=

# Clés de vault fournies par les clients (BYOK), au format JSON :
#   {"acme-corp": "<64 hex>", "autre-client": "<64 hex>"}
# Par défaut, la clé de chaque client est DÉRIVÉE de VAULT_MASTER_KEY :
# le cloisonnement entre organisations est déjà cryptographique, mais
# vous conservez la capacité de déchiffrer. Un client qui fournit la
# sienne devient le seul à pouvoir lire son vault — y compris face à un
# accès complet à la base. Cette clé perdue, son vault l'est aussi.
VAULT_CLIENT_KEYS=

# Origines autorisées à appeler l'API depuis un navigateur, séparées par
# des virgules (ex. https://sentinel.mondomaine.fr). Vide = origines de
# développement local uniquement — le mode strict REFUSE de démarrer
# ainsi. `*` est rejeté : la console s'authentifie par cookie, et une
# origine joker laisserait n'importe quel site piloter une session
# d'administrateur.
CORS_ORIGINS=

# Token d'administration (création des clés clients via /admin/keys).
# Distinct des clés cryptographiques. Si vide, repli sur AUDIT_HMAC_KEY.
ADMIN_TOKEN=

# Rate-limiting : requêtes/minute par client (fenêtre glissante). 0 = désactivé.
RATE_LIMIT_PER_MINUTE=120

# Token du dashboard (stats + WebSocket temps réel).
# Vide = accès libre (dev/démo) ; défini = obligatoire.
DASHBOARD_TOKEN=

# Format des logs : json (production) ou text (dev lisible)
LOG_FORMAT=json

# Mode strict (production) : refuse de démarrer si persistance absente,
# clés par défaut, ou tokens admin/dashboard non définis. Fail-closed.
STRICT_MODE=false

# Durées de conservation.
# Jetons du vault (restauration des vraies valeurs) : supprimés au-delà.
VAULT_TTL_HOURS=24
# Journal d'audit, en jours (0 = illimité). Au-delà, les entrées sont
# CONSERVÉES — la chaîne doit rester vérifiable (AI Act art. 26(6)) —
# mais leur clé de déchiffrement est détruite : la preuve demeure, la
# donnée personnelle devient illisible.
AUDIT_RETENTION_DAYS=0
# Période entre deux passes de purge, en minutes (0 = désactivé).
PURGE_INTERVAL_MINUTES=60
# Période entre deux vérifications COMPLÈTES du journal, en heures.
# La vérification incrémentale (à chaque passe) ne détecte pas une
# altération ANTÉRIEURE au dernier point de contrôle ; seule la
# complète le fait. 0 = jamais (démarrage et à la demande seulement).
AUDIT_FULL_VERIFY_HOURS=24

# Juge local L4 (optionnel ; sur Docker, host.docker.internal pointe vers l'hôte)
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_JUDGE_MODEL=qwen2.5:14b
# Au-dela, on abandonne le rattrapage plutot que de faire attendre.
L4_TIMEOUT_SECONDS=30
# Streaming : true = fragments du fournisseur relayés au fil de l'eau
# (latence minimale). false = réponse complète puis découpage simulé,
# ce qui rétablit la récupération floue des jetons corrompus.
STREAM_NATIVE=true

# --- SSO d'entreprise (OpenID Connect) ---
# Actif dès que l'émetteur et l'identifiant client sont renseignés.
# Le DASHBOARD_TOKEN reste accepté en accès de secours.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:8000/auth/callback
# OBLIGATOIRE : sans restriction, tout compte connu du fournisseur entrerait.
OIDC_ALLOWED_DOMAINS=
OIDC_ALLOWED_GROUPS=
# Correspondance groupes -> roles de la console. Un compte autorise
# mais sans groupe reconnu recoit le role le plus faible.
OIDC_ADMIN_GROUPS=
OIDC_AUDITOR_GROUPS=
OIDC_VIEWER_GROUPS=
SESSION_TTL_HOURS=8
# Mettre à false uniquement en HTTP local (le cookie exige HTTPS sinon).
SESSION_COOKIE_SECURE=true

# Fils d'execution pour la detection (travail CPU : spaCy, Presidio).
# 0 = nombre de coeurs. Au-dela, les fils se disputent le GIL et le
# debit s'effondre au lieu de plafonner (mesure : 70 req/s a 8
# requetes simultanees, 12 req/s a 16 sans bornage).
DETECTION_WORKERS=0
